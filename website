    }
    .btn-save { background: linear-gradient(135deg, var(--bsi-teal), var(--bsi-teal-light)); color: white; box-shadow: 0 8px 20px rgba(0,163,157,0.5); }
    .btn-save:hover { background: var(--bsi-teal-dark); transform: translateY(-5px); box-shadow: 0 15px 30px rgba(0,163,157,0.4); letter-spacing: 0.5px; }
    .btn-cancel { background: #F1F4F9; color: var(--bsi-navy); }
    .btn-cancel:hover { background: #E6EAEF; transform: translateY(-3px); }

    /* BADGES & ANALYSIS dengan efek glow */
    .status-badge { display: inline-block; padding: 6px 20px; border-radius: 60px; font-size: 12px; font-weight: 800; letter-spacing: 0.5px; backdrop-filter: blur(2px); transition: var(--transition); }
    .status-disetujui { background: #E6F4EE; color: var(--bsi-teal); border: 1px solid var(--bsi-teal); box-shadow: 0 0 6px rgba(0,163,157,0.3); }
    .status-ditolak { background: #FEF2EF; color: var(--bsi-orange-dark); border: 1px solid var(--bsi-orange); box-shadow: 0 0 6px rgba(248,173,60,0.3); }
    .status-terkirim { background: #FEF6E6; color: var(--bsi-orange); border: 1px solid var(--bsi-orange); }
    .analysis-card {
      background: linear-gradient(145deg, #F8FAFE, #FFFFFF);
      border-radius: var(--radius-lg);
      padding: 30px;
      margin-top: 28px;
      border-left: 8px solid var(--bsi-orange);
      transition: var(--transition);
      box-shadow: var(--shadow-sm);
    }
    .analysis-title { font-size: 24px; font-weight: 800; color: var(--bsi-teal-dark); margin-bottom: 22px; display: flex; align-items: center; gap: 12px; }
    .analysis-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .analysis-item { background: white; padding: 18px; border-radius: var(--radius-md); border: 1px solid #E2E8F0; transition: var(--transition); }
    .analysis-item:hover { transform: translateY(-4px); border-color: var(--bsi-teal); box-shadow: 0 0 12px rgba(0,163,157,0.2); }
    .analysis-item .label { font-size: 12px; color: var(--bsi-gray); margin-bottom: 6px; font-weight: 700; }
    .analysis-item .value { font-size: 22px; font-weight: 800; color: var(--bsi-teal-dark); }
    .installment-table {
      margin-top: 24px;
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      background: white;
      border-radius: var(--radius-md);
      overflow: hidden;
    }
    .installment-table th, .installment-table td { padding: 12px 18px; text-align: right; border-bottom: 1px solid #E9EEF2; }
    .installment-table th { background: #F1F6FA; color: var(--bsi-teal-dark); font-weight: 800; text-align: center; }
    .installment-table td { text-align: right; }
    .installment-table td:first-child, .installment-table th:first-child { text-align: left; }
    .installment-note { font-size: 12px; color: var(--bsi-gray); margin-top: 14px; text-align: center; font-style: italic; }
    .toast {
      position: fixed;
      bottom: 30px;
      right: 30px;
      background: linear-gradient(135deg, var(--bsi-teal), var(--bsi-teal-light));
      color: white;
      padding: 14px 32px;
      border-radius: 60px;
      font-size: 14px;
      font-weight: 700;
      box-shadow: 0 15px 35px -12px rgba(0,0,0,0.3);
      z-index: 3000;
      display: none;
      align-items: center;
      gap: 14px;
      animation: slideInRight 0.3s ease;
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255,255,255,0.3);
    }
    .toast.show { display: flex; }
    @keyframes slideInRight { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

    /* Utility badges dengan glow */
    .badge-diterima { background: #E0F2F0; color: var(--bsi-teal-dark); padding: 4px 14px; border-radius: 30px; font-weight: 800; box-shadow: 0 0 6px rgba(0,163,157,0.3); }
    .badge-ditolak { background: #FFEDE6; color: var(--bsi-orange-dark); padding: 4px 14px; border-radius: 30px; font-weight: 800; box-shadow: 0 0 6px rgba(248,173,60,0.3); }
    .badge-rendah { background: #DCFCE7; color: #15803D; padding: 4px 14px; border-radius: 30px; }
    .badge-sedang { background: #FEF9C3; color: #854D0E; padding: 4px 14px; border-radius: 30px; }
