    .clear-btn {
      background: #F8FAFE;
      border: 1px solid #E2E8F0;
      padding: 12px 36px;
      border-radius: 60px;
      font-weight: 700;
      cursor: pointer;
      margin-top: 32px;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      transition: var(--transition);
      color: var(--bsi-teal-dark);
    }
    .clear-btn:hover { background: #EFF3F8; transform: translateY(-4px); border-color: var(--bsi-teal); gap: 14px; box-shadow: 0 5px 15px rgba(0,163,157,0.2); }

    /* MODAL - efek glassmorphism dengan border gradien animasi */
    .modal {
      display: none;
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0,0,0,0.65);
      align-items: center;
      justify-content: center;
      z-index: 2000;
      backdrop-filter: blur(12px);
    }
    .modal.active { display: flex; animation: fadeModal 0.25s ease; }
    @keyframes fadeModal { from { opacity: 0; } to { opacity: 1; } }
    .modal-content {
      background: rgba(255,255,255,0.98);
      border-radius: 60px;
      padding: 48px;
