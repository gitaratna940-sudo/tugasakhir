<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mitraguna · Kredit Analytics | BSI Official</title>
  <!-- Font Awesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <!-- Google Fonts: Inter + Playfair Display -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --bsi-teal: #00A39D;
      --bsi-teal-light: #33C2BA;
      --bsi-teal-dark: #007F7A;
      --bsi-orange: #F8AD3C;
      --bsi-orange-light: #FBC75E;
      --bsi-orange-dark: #E08E1A;
      --bsi-white: #FFFFFF;
      --bsi-cream: #F8F9FA;
      --bsi-navy: #0F2F5F;
      --bsi-gray: #6C7A89;
      --shadow-sm: 0 8px 20px rgba(0, 0, 0, 0.05), 0 2px 6px rgba(0, 0, 0, 0.03);
      --shadow-md: 0 20px 35px -12px rgba(0, 0, 0, 0.15), 0 4px 12px rgba(0, 0, 0, 0.05);
      --shadow-lg: 0 30px 45px -16px rgba(0, 0, 0, 0.25);
      --sidebar-width: 280px;
      --radius-sm: 12px;
      --radius-md: 18px;
      --radius-lg: 24px;
      --radius-xl: 32px;
      --transition: all 0.35s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    }
    body {
      font-family: 'Inter', sans-serif;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--bsi-navy);
      position: relative;
      overflow: hidden;
    }
    /* ========== BACKGROUND LOGIN DENGAN ANIMASI BERGERAK SUPER DINAMIS ========== */
    body {
      background: linear-gradient(125deg, #003d3a, #00635F, #00A39D, #F8AD3C, #00635F, #003d3a);
      background-size: 400% 400%;
      animation: gradientFlow 15s ease infinite;
    }
    @keyframes gradientFlow {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
    /* Partikel / lingkaran apung lebih banyak */
    body::before {
      content: "";
      position: absolute;
      width: 100%;
      height: 100%;
      background-image: radial-gradient(circle at 20% 40%, rgba(248,173,60,0.25) 2px, transparent 2px),
                        radial-gradient(circle at 80% 70%, rgba(0,163,157,0.3) 1px, transparent 2px),
                        radial-gradient(circle at 40% 80%, rgba(255,255,255,0.2) 1px, transparent 2px);
      background-size: 60px 60px, 90px 90px, 120px 120px;
      pointer-events: none;
      z-index: 0;
      animation: floatParticles 25s linear infinite;
    }
    @keyframes floatParticles {
      0% { transform: translate(0, 0) rotate(0deg); opacity: 0.7; }
      50% { transform: translate(3%, 4%) rotate(3deg); opacity: 1; }
      100% { transform: translate(-2%, -3%) rotate(-3deg); opacity: 0.7; }
    }
    /* Blob besar bergerak dengan efek neon */
    body::after {
      content: "";
      position: absolute;
      width: 150%;
      height: 150%;
      top: -25%;
      left: -25%;
      background: radial-gradient(ellipse at 30% 40%, rgba(0,163,157,0.15) 0%, rgba(248,173,60,0.08) 50%, transparent 80%);
      animation: rotateBlob 30s infinite alternate;
      pointer-events: none;
      z-index: 0;
      filter: blur(40px);
    }
    @keyframes rotateBlob {
      0% { transform: translate(0, 0) scale(1) rotate(0deg); opacity: 0.4; }
      100% { transform: translate(6%, 10%) scale(1.4) rotate(15deg); opacity: 0.8; }
    }

    /* LOGIN PAGE - Glassmorphism premium dengan border gradien */
    .login-container {
      width: 460px;
      background: rgba(255,255,255,0.92);
      backdrop-filter: blur(20px);
      border-radius: var(--radius-xl);
      padding: 48px 40px;
      box-shadow: var(--shadow-lg), 0 0 0 1px rgba(0,163,157,0.3) inset;
      border: 1px solid rgba(255,255,255,0.6);
      position: relative;
      z-index: 10;
      animation: fadeInUp 0.7s cubic-bezier(0.2, 0.9, 0.4, 1.1);
      transition: transform 0.4s, box-shadow 0.4s;
    }
    .login-container:hover {
      transform: translateY(-10px) scale(1.01);
      box-shadow: 0 40px 60px -20px rgba(0,0,0,0.4), 0 0 0 2px rgba(0,163,157,0.4) inset;
    }
    @keyframes fadeInUp { from { opacity: 0; transform: translateY(70px); } to { opacity: 1; transform: translateY(0); } }
    .login-container h2 {
      font-family: 'Playfair Display', serif;
      font-size: 36px;
      font-weight: 700;
      background: linear-gradient(135deg, var(--bsi-teal-dark), var(--bsi-orange));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      margin-bottom: 36px;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }
    .login-container h2 img { height: 85px; width: auto; filter: drop-shadow(0 8px 20px rgba(0,0,0,0.15)); transition: transform 0.4s; }
    .login-container h2 img:hover { transform: scale(1.08) rotate(1deg); }
    .login-container .input-group { position: relative; margin-bottom: 28px; }
    .login-container .input-group i {
      position: absolute;
      left: 20px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--bsi-teal);
      font-size: 1.3rem;
      transition: var(--transition);
      z-index: 2;
    }
    .login-container input,
    .login-container select {
      width: 100%;
      padding: 16px 20px 16px 52px;
      border: 1px solid rgba(0,163,157,0.3);
      border-radius: 60px;
      font-size: 15px;
      background: white;
      transition: var(--transition);
      color: var(--bsi-navy);
      font-weight: 500;
    }
    .login-container input:focus,
    .login-container select:focus {
      border-color: var(--bsi-teal);
      outline: none;
      box-shadow: 0 0 0 5px rgba(0,163,157,0.2), 0 0 15px rgba(0,163,157,0.4);
      transform: scale(1.02);
    }
    .login-container input:focus + i,
    .login-container select:focus + i { color: var(--bsi-teal-light); transform: translateY(-50%) scale(1.1); text-shadow: 0 0 5px rgba(0,163,157,0.5); }
    .login-container button {
      width: 100%;
      padding: 16px;
      background: linear-gradient(135deg, var(--bsi-teal), var(--bsi-teal-light));
      color: white;
      border: none;
      border-radius: 60px;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      margin: 32px 0 16px;
      transition: var(--transition);
      box-shadow: 0 10px 25px -8px rgba(0,163,157,0.6);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      position: relative;
      overflow: hidden;
    }
    .login-container button::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.5), transparent);
      transition: left 0.6s;
    }
    .login-container button:hover::before { left: 100%; }
    .login-container button:hover { transform: translateY(-4px); box-shadow: 0 18px 30px -10px var(--bsi-teal); letter-spacing: 1px; }
    #error { color: #D45A4A; text-align: center; font-size: 14px; margin-top: 10px; font-weight: 500; }
    .login-hint { font-size: 13px; color: #7F8C8D; text-align: center; margin-top: 20px; padding-top: 16px; border-top: 1px solid rgba(0,163,157,0.2); }

    /* ========== DASHBOARD - SUPER MENARIK DENGAN EFEK NEON & PARTIKEL ========== */
    .dashboard {
      display: none;
      width: 100%;
      height: 100vh;
      background: radial-gradient(circle at 20% 30%, #F4FAFF 0%, #E9F2F8 100%);
      position: relative;
      overflow: hidden;
    }
    /* Pola titik-titik dinamis + gelombang */
    .dashboard::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: radial-gradient(circle at 15% 30%, rgba(0,163,157,0.12) 1.5px, transparent 1.5px);
      background-size: 40px 40px;
      pointer-events: none;
      z-index: 0;
      animation: particleShift 35s linear infinite;
    }
    @keyframes particleShift {
      0% { background-position: 0 0; }
      100% { background-position: 120px 120px; }
    }
    /* Efek cahaya berputar dengan neon */
    .dashboard::after {
      content: "";
      position: absolute;
      top: -15%;
      right: -15%;
      width: 80%;
      height: 80%;
      background: radial-gradient(circle, rgba(248,173,60,0.15) 0%, rgba(0,163,157,0.08) 50%, transparent 80%);
      pointer-events: none;
      z-index: 0;
      animation: slowSpin 40s infinite alternate;
      filter: blur(50px);
    }
    @keyframes slowSpin {
      0% { transform: translate(0, 0) scale(1) rotate(0deg); opacity: 0.5; }
      100% { transform: translate(60px, -50px) scale(1.5) rotate(15deg); opacity: 0.9; }
    }

    /* SIDEBAR - Glassmorphism dengan border gradien animasi */
    .sidebar {
      width: var(--sidebar-width);
      background: rgba(255,255,255,0.88);
      backdrop-filter: blur(16px);
      border-right: 1px solid rgba(0,163,157,0.3);
      display: flex;
      flex-direction: column;
      padding: 32px 0 24px;
      box-shadow: 8px 0 32px -12px rgba(0,0,0,0.15);
      position: fixed;
      top: 0;
      left: 0;
      height: 100%;
      z-index: 20;
      transition: var(--transition);
    }
    .sidebar:hover { backdrop-filter: blur(20px); background: rgba(255,255,255,0.96); }
    .sidebar .logo { padding: 0 24px 32px; border-bottom: 1px solid rgba(0,163,157,0.25); margin-bottom: 24px; text-align: center; }
    .sidebar .logo img { height: 72px; width: auto; transition: all 0.4s; filter: drop-shadow(0 6px 12px rgba(0,0,0,0.1));}
    .sidebar .logo img:hover { transform: scale(1.08) rotate(2deg); filter: drop-shadow(0 8px 20px rgba(0,163,157,0.3)); }
    .sidebar nav { flex: 1; }
    .sidebar nav a {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 12px 28px;
      color: #2C3E50;
      text-decoration: none;
      font-size: 15px;
      font-weight: 500;
      transition: var(--transition);
      border-left: 3px solid transparent;
      margin: 6px 12px;
      border-radius: 50px;
      cursor: pointer;
      position: relative;
      overflow: hidden;
    }
    .sidebar nav a i { width: 24px; font-size: 1.2rem; color: #7F8C8D; transition: var(--transition); }
    .sidebar nav a::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 0%;
      height: 100%;
      background: linear-gradient(90deg, rgba(0,163,157,0.15), rgba(248,173,60,0.08));
      transition: width 0.45s;
      z-index: -1;
    }
    .sidebar nav a:hover::before { width: 100%; }
    .sidebar nav a:hover { color: var(--bsi-teal-dark); transform: translateX(8px); }
    .sidebar nav a:hover i { color: var(--bsi-teal); transform: scale(1.15) rotate(5deg); text-shadow: 0 0 8px rgba(0,163,157,0.5); }
    .sidebar nav a.active { background: linear-gradient(90deg, rgba(0,163,157,0.2), transparent); color: var(--bsi-teal-dark); border-left-color: var(--bsi-orange); font-weight: 700; box-shadow: 0 0 15px rgba(0,163,157,0.3); }
    .sidebar nav a.active i { color: var(--bsi-teal); text-shadow: 0 0 10px rgba(0,163,157,0.6); }
    .sidebar .logout { margin-top: auto; border-top: 1px solid rgba(0,163,157,0.25); padding: 24px 24px 0; }
    .sidebar .logout a {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--bsi-orange-dark);
      font-weight: 700;
      cursor: pointer;
      padding: 10px 20px;
      border-radius: 50px;
      transition: var(--transition);
      background: rgba(248,173,60,0.08);
    }
    .sidebar .logout a:hover { background: rgba(248,173,60,0.25); transform: translateX(10px); gap: 18px; text-shadow: 0 0 5px rgba(248,173,60,0.5); }

    /* MAIN CONTENT dengan animasi fade-slide yang lebih halus */
    .main-content {
      margin-left: var(--sidebar-width);
      padding: 36px 44px;
      height: 100%;
      overflow-y: auto;
      position: relative;
      z-index: 10;
      scroll-behavior: smooth;
      animation: contentGlow 0.6s ease-out;
    }
    @keyframes contentGlow {
      from { opacity: 0; transform: translateY(25px); filter: blur(2px); }
      to { opacity: 1; transform: translateY(0); filter: blur(0); }
    }
    /* Custom scrollbar premium dengan gradien */
    .main-content::-webkit-scrollbar { width: 8px; }
    .main-content::-webkit-scrollbar-track { background: #E0E8F0; border-radius: 10px; }
    .main-content::-webkit-scrollbar-thumb { background: linear-gradient(135deg, var(--bsi-teal), var(--bsi-orange)); border-radius: 10px; }
    .main-content::-webkit-scrollbar-thumb:hover { background: var(--bsi-teal); transform: scale(1.1); }

    /* PAGE HEADER dengan efek gradien dan glow */
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 40px;
      flex-wrap: wrap;
      gap: 20px;
    }
    .page-header h2 {
      font-family: 'Playfair Display', serif;
      font-size: 36px;
      font-weight: 800;
      background: linear-gradient(135deg, var(--bsi-teal-dark), var(--bsi-orange));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      display: flex;
      align-items: center;
      gap: 14px;
      text-shadow: 0 2px 10px rgba(0,163,157,0.2);
    }
    .page-header h2 i {
      background: rgba(255,255,255,0.8);
      padding: 14px;
      border-radius: 30px;
      color: var(--bsi-orange);
      font-size: 30px;
      box-shadow: var(--shadow-md);
      transition: var(--transition);
    }
    .page-header h2 i:hover { transform: scale(1.12) rotate(6deg); background: white; box-shadow: 0 0 20px rgba(0,163,157,0.4); }
    .header-actions { display: flex; gap: 20px; align-items: center; }
    .date-badge {
      background: rgba(255,255,255,0.75);
      backdrop-filter: blur(12px);
      padding: 12px 32px;
      border-radius: 60px;
      font-weight: 700;
      color: var(--bsi-teal-dark);
      font-size: 14px;
      box-shadow: var(--shadow-sm);
      border: 1px solid rgba(0,163,157,0.4);
      transition: var(--transition);
    }
    .date-badge:hover { transform: scale(1.02); border-color: var(--bsi-orange); }

    /* CARDS dengan efek glassmorphism dan border glow */
    .card, .chart-card, .recent-card, .summary-card, .detail-panel {
      background: rgba(255,255,255,0.82);
      backdrop-filter: blur(8px);
      border-radius: var(--radius-xl);
      padding: 28px;
      box-shadow: var(--shadow-sm);
      border: 1px solid rgba(255,255,255,0.7);
      margin-bottom: 32px;
      transition: var(--transition);
    }
    .card:hover, .chart-card:hover, .recent-card:hover, .summary-card:hover, .detail-panel:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-6px);
      border-color: rgba(0,163,157,0.4);
      background: rgba(255,255,255,0.96);
      backdrop-filter: blur(4px);
    }

    /* STATISTICS GRID - efek floating dan neon border */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
      gap: 30px;
      margin-bottom: 40px;
    }
    .stat-item {
      background: rgba(255,255,255,0.88);
      backdrop-filter: blur(6px);
      border-radius: var(--radius-lg);
      padding: 28px;
      border: 1px solid rgba(0,163,157,0.25);
      display: flex;
      align-items: center;
      gap: 24px;
      transition: var(--transition);
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      animation: floatSoft 4s infinite ease-in-out;
    }
    @keyframes floatSoft {
      0% { transform: translateY(0px); }
      50% { transform: translateY(-6px); }
      100% { transform: translateY(0px); }
    }
    .stat-item::after {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 8px;
      height: 100%;
      background: linear-gradient(to bottom, var(--bsi-teal), var(--bsi-orange));
      border-radius: 6px 0 0 6px;
      box-shadow: 0 0 12px rgba(0,163,157,0.6);
    }
    .stat-item:hover { transform: translateY(-10px) scale(1.02); box-shadow: var(--shadow-lg); background: white; animation: none; }
    .stat-icon {
      width: 80px;
      height: 80px;
      background: linear-gradient(145deg, rgba(0,163,157,0.15), rgba(248,173,60,0.1));
      border-radius: 35px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--bsi-teal);
      font-size: 40px;
      transition: var(--transition);
    }
    .stat-item:hover .stat-icon { transform: scale(1.1) rotate(5deg); color: var(--bsi-orange); text-shadow: 0 0 12px rgba(248,173,60,0.5); }
    .stat-content h3 { font-size: 42px; font-weight: 800; color: var(--bsi-teal-dark); line-height: 1.1; letter-spacing: -1px; }
    .stat-content p { color: var(--bsi-gray); font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: 1.5px; }

    /* DASHBOARD ROW */
    .dashboard-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 35px;
      margin-bottom: 40px;
    }
    .right-sidebar { display: flex; flex-direction: column; gap: 35px; }
    .chart-card h3, .recent-card h3, .summary-card h3 {
      font-size: 24px;
      font-weight: 800;
      color: var(--bsi-teal-dark);
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .chart-card h3 i, .recent-card h3 i, .summary-card h3 i { color: var(--bsi-orange); font-size: 32px; filter: drop-shadow(0 0 6px rgba(248,173,60,0.5)); }
    .summary-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 22px;
      margin-top: 12px;
    }
    .summary-item {
      background: rgba(248,250,254,0.9);
      border-radius: var(--radius-lg);
      padding: 22px;
      text-align: center;
      transition: var(--transition);
      border: 1px solid transparent;
    }
    .summary-item:hover { background: white; transform: translateY(-6px); border-color: var(--bsi-teal); box-shadow: var(--shadow-md); }
    .summary-item .label { font-size: 13px; color: var(--bsi-gray); margin-bottom: 8px; font-weight: 700; }
    .summary-item .value { font-size: 30px; font-weight: 800; color: var(--bsi-teal-dark); }
    .recent-list {
      max-height: 280px;
      overflow-y: auto;
    }
    .recent-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 12px;
      border-bottom: 1px solid rgba(0,163,157,0.15);
      transition: var(--transition);
      border-radius: 20px;
    }
    .recent-item:hover { background: rgba(0,163,157,0.08); padding-left: 20px; padding-right: 20px; transform: translateX(6px); }

    /* SEARCH & TOOLBAR dengan efek neon */
    .search-box {
      display: flex;
      align-items: center;
      background: white;
      border: 1px solid rgba(0,163,157,0.4);
      border-radius: 60px;
      padding: 4px 4px 4px 24px;
      box-shadow: var(--shadow-sm);
      transition: var(--transition);
    }
    .search-box:focus-within { border-color: var(--bsi-teal); box-shadow: 0 0 0 5px rgba(0,163,157,0.2), 0 0 20px rgba(0,163,157,0.3); transform: scale(1.01); }
    .search-box i { color: var(--bsi-teal); font-size: 1.2rem; text-shadow: 0 0 4px rgba(0,163,157,0.4); }
    .search-box input {
      border: none;
      padding: 12px 12px;
      font-size: 15px;
      width: 280px;
      outline: none;
      background: transparent;
      color: var(--bsi-navy);
      font-weight: 500;
    }
    .search-box button {
      background: linear-gradient(135deg, var(--bsi-teal), var(--bsi-teal-light));
      border: none;
      color: white;
      padding: 8px 32px;
      border-radius: 50px;
      font-weight: 700;
      cursor: pointer;
      transition: var(--transition);
      font-size: 14px;
    }
    .search-box button:hover { background: var(--bsi-teal-dark); transform: scale(1.03); box-shadow: 0 0 12px rgba(0,163,157,0.6); }
    .btn-add {
      background: linear-gradient(135deg, var(--bsi-orange), var(--bsi-orange-light));
      color: white;
      border: none;
      padding: 12px 36px;
      border-radius: 60px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 12px;
      cursor: pointer;
      transition: var(--transition);
      box-shadow: 0 8px 20px rgba(248,173,60,0.4);
    }
    .btn-add:hover { background: var(--bsi-orange-dark); transform: translateY(-5px); box-shadow: 0 15px 28px rgba(248,173,60,0.5); gap: 16px; letter-spacing: 0.5px; }

    /* TABLE - desain modern dengan efek zebra dan glow */
    .table-wrapper {
      overflow-x: auto;
      border-radius: var(--radius-lg);
      border: 1px solid rgba(0,163,157,0.2);
      background: white;
      max-height: 540px;
      overflow-y: auto;
      margin-bottom: 24px;
    }
    .table-wrapper::-webkit-scrollbar { height: 6px; width: 6px; }
    .table-wrapper::-webkit-scrollbar-track { background: #E9EEF2; border-radius: 10px; }
    .table-wrapper::-webkit-scrollbar-thumb { background: linear-gradient(135deg, var(--bsi-teal), var(--bsi-orange)); border-radius: 10px; }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
      min-width: 1200px;
