      <a data-menu="export" class="menu-for-user"><i class="fas fa-download"></i> Export</a>
      <a data-menu="pengaturan" class="menu-for-user"><i class="fas fa-cog"></i> Pengaturan Model</a>
      <a data-menu="bantuan" class="menu-for-user"><i class="fas fa-question-circle"></i> Bantuan</a>
