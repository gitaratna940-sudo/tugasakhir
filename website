    }
    .btn-icon.edit:hover { background: #E6F4EE; color: var(--bsi-teal); border-color: var(--bsi-teal); transform: scale(1.1) rotate(4deg); box-shadow: 0 0 12px rgba(0,163,157,0.4); }
    .btn-icon.delete:hover { background: #FEF2EF; color: var(--bsi-orange-dark); border-color: var(--bsi-orange); transform: scale(1.1) rotate(-4deg); box-shadow: 0 0 12px rgba(248,173,60,0.4); }

    /* PAGINATION dengan efek ripple */
    .pagination {
      display: flex;
      justify-content: center;
      gap: 14px;
      margin-bottom: 28px;
    }
    .pagination button {
      background: white;
