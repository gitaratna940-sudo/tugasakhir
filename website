    .detail-item:hover { transform: translateY(-5px); background: white; border-color: var(--bsi-teal); box-shadow: var(--shadow-sm); }
    .detail-item .label { font-size: 13px; color: var(--bsi-gray); margin-bottom: 8px; font-weight: 700; letter-spacing: 0.5px; }
