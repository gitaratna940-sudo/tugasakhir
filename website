    }
    @keyframes modalZoom { from { transform: scale(0.92); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    .modal-content h3 { font-family: 'Playfair Display', serif; font-size: 36px; font-weight: 800; color: var(--bsi-teal-dark); margin-bottom: 40px; border-left: 8px solid var(--bsi-orange); padding-left: 28px; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
