    <h3 id="modalTitle">Tambah Debitur</h3>
    <form id="crudForm" onsubmit="event.preventDefault(); saveData();">
      <div id="formFields" class="form-grid"></div>
      <div id="analysisResult" class="analysis-card" style="display: none;"></div>
      <div class="modal-actions">
        <button type="button" class="btn-cancel" onclick="closeModal()">Batal</button>
        <button type="submit" class="btn-save">Simpan</button>
      </div>
    </form>
  </div>
</div>

<div id="toast" class="toast"><i class="fas fa-check-circle"></i> <span id="toastMsg"></span></div>

<script>
  // ================= KONFIGURASI (SAMA PERSIS SEPERTI SEBELUMNYA, TIDAK BERUBAH) ==================
  const USER_ADMIN = { user: 'admin', pass: 'admin123' };
  const USER_VIEWER = { user: 'user', pass: 'user123' };
  const API_URL = "https://script.google.com/macros/s/AKfycbyp6nhXUQwUzm7M-XtEEUZpuryPH9XaQHzqGtgM70o9erA9hANS4Na4x2iCqgyVt6vkcQ/exec";

  let dataGlobal = [], filteredData = [], currentPage = 1, rowsPerPage = 10, selectedRowId = null, editingIndex = -1;
  let headerColumns = [], colMap = { id: -1, namaEmail: -1, usia: -1, income: -1, loan: -1, dsr: -1, grade: -1 };
  let keputusanColIndex = -1, statusColIndex = -1, currentRole = 'admin', auditLogs = [];

  const tenorOptions = [
    { tahun: 3, angsuranPer100jt: 3150000 },
    { tahun: 5, angsuranPer100jt: 2040000 },
    { tahun: 8, angsuranPer100jt: 1440000 },
    { tahun: 10, angsuranPer100jt: 1226000 },
    { tahun: 12, angsuranPer100jt: 1096000 },
    { tahun: 15, angsuranPer100jt: 970000 }
  ];

  function hitungAngsuranPerTenor(plafon) {
    if (!plafon || plafon <= 0) return [];
    const hasil = [];
    for (const t of tenorOptions) {
      const angsuranPerJuta = t.angsuranPer100jt / 100000000;
      const angsuran = plafon * angsuranPerJuta;
      hasil.push({ tahun: t.tahun, angsuran: Math.round(angsuran) });
    }
    return hasil;
  }

  function hitungRisiko(lamaBekerja) {
    const tahun = parseFloat(lamaBekerja);
    if (isNaN(tahun)) return "sedang";
    if (tahun <= 1) return "tinggi";
    if (tahun <= 5) return "sedang";
    return "rendah";
  }

  function hitungKeputusan(riwayatGagalBayar) {
    return riwayatGagalBayar && riwayatGagalBayar.toLowerCase() === 'ya' ? "DITOLAK" : "DITERIMA";
  }

  function hitungAnalisis(data) {
    const pendapatan = parseFloat(data.pendapatan) || 0;
    const lamaBekerja = parseFloat(data.lamaBekerja) || 0;
    const riwayat = data.riwayatGagalBayar || "";
    const plafonDiajukan = parseFloat(data.plafonDiajukan) || 0;
    const kemampuanCicilan = pendapatan * 0.7;
    let tenorDisarankan = 0, estimasiAngsuran = 0;
    for (const tenor of tenorOptions) {
      const angsuranPerJuta = tenor.angsuranPer100jt / 100000000;
      const angsuran = plafonDiajukan * angsuranPerJuta;
      if (angsuran <= kemampuanCicilan) { estimasiAngsuran = angsuran; tenorDisarankan = tenor.tahun; break; }
    }
    if (tenorDisarankan === 0 && plafonDiajukan > 0) {
      const tenor = tenorOptions[tenorOptions.length-1];
      const angsuranPerJuta = tenor.angsuranPer100jt / 100000000;
      estimasiAngsuran = plafonDiajukan * angsuranPerJuta;
      tenorDisarankan = tenor.tahun;
    }
    const keputusan = hitungKeputusan(riwayat);
    const risiko = hitungRisiko(lamaBekerja);
    return {
      keputusan, plafonDiajukan, tenorDisarankan, estimasiAngsuranPerBulan: Math.round(estimasiAngsuran),
      risiko, kemampuanCicilan: Math.round(kemampuanCicilan),
      alasan: `Riwayat gagal bayar: ${riwayat === 'ya' ? 'Ya' : 'Tidak'}. Kemampuan cicilan maksimal: Rp ${Math.round(kemampuanCicilan).toLocaleString('id-ID')}/bulan.`
    };
  }

  function updateAnalysis() {
    const formData = {};
    if (colMap.loan !== -1) {
      const loanField = document.getElementById(`field_${colMap.loan}`);
      if (loanField && loanField.value) formData.plafonDiajukan = loanField.value;
    }
    for (let i = 0; i < headerColumns.length; i++) {
      if (i === keputusanColIndex || i === statusColIndex) continue;
      const input = document.getElementById(`field_${i}`);
      if (input) {
        const headerLower = headerColumns[i].toLowerCase();
        if (headerLower.includes('pendapatan') || headerLower.includes('income')) formData.pendapatan = input.value;
        if (headerLower.includes('lama bekerja') || headerLower.includes('lama kerja')) formData.lamaBekerja = input.value;
      }
    }
    const riwayatCheckbox = document.getElementById("riwayatGagalBayar");
    if (riwayatCheckbox) formData.riwayatGagalBayar = riwayatCheckbox.checked ? "ya" : "tidak";
    const analysis = hitungAnalisis(formData);
    const analysisDiv = document.getElementById("analysisResult");
    if (analysisDiv) {
      analysisDiv.style.display = "block";
      const angsuranList = hitungAngsuranPerTenor(analysis.plafonDiajukan);
      let installmentHtml = '<table class="installment-table"><thead><tr><th>Tenor (tahun)</th><th>Estimasi Angsuran / Bulan</th></tr></thead><tbody>';
      for (const a of angsuranList) installmentHtml += `<tr><td>${a.tahun} tahun</td><td>Rp ${a.angsuran.toLocaleString('id-ID')}</td></tr>`;
      installmentHtml += '</tbody></table><div class="installment-note">*Perhitungan berdasarkan plafon yang diajukan dan tabel angsuran Mitraguna.</div>';
      analysisDiv.innerHTML = `
        <div class="analysis-title"><i class="fas fa-chart-line"></i> Analisis Kredit Otomatis</div>
        <div class="analysis-grid">
          <div class="analysis-item"><div class="label">Keputusan</div><div class="value"><span class="analysis-badge ${analysis.keputusan === 'DITERIMA' ? 'badge-diterima' : 'badge-ditolak'}">${analysis.keputusan}</span></div></div>
          <div class="analysis-item"><div class="label">Risiko</div><div class="value"><span class="analysis-badge ${analysis.risiko === 'rendah' ? 'badge-rendah' : (analysis.risiko === 'sedang' ? 'badge-sedang' : 'badge-tinggi')}">${analysis.risiko.toUpperCase()}</span></div></div>
          <div class="analysis-item"><div class="label">Kemampuan Cicilan Maksimal</div><div class="value">Rp ${analysis.kemampuanCicilan.toLocaleString('id-ID')}</div></div>
          <div class="analysis-item"><div class="label">Plafon Diajukan</div><div class="value">Rp ${analysis.plafonDiajukan.toLocaleString('id-ID')}</div></div>
          <div class="analysis-item"><div class="label">Tenor Disarankan</div><div class="value">${analysis.tenorDisarankan} tahun</div></div>
          <div class="analysis-item"><div class="label">Estimasi Angsuran</div><div class="value">Rp ${analysis.estimasiAngsuranPerBulan.toLocaleString('id-ID')}</div></div>
        </div>
        ${installmentHtml}
        <div class="analysis-item" style="grid-column: span 2; margin-top: 12px;"><div class="label">Alasan</div><div class="value" style="font-size: 14px; font-weight: normal;">${analysis.alasan}</div></div>
      `;
    }
  }

  function showToast(message, isError = false) {
    const toast = document.getElementById("toast");
    const msgSpan = document.getElementById("toastMsg");
    msgSpan.textContent = message;
    toast.style.background = isError ? "linear-gradient(135deg, var(--bsi-orange), var(--bsi-orange-light))" : "linear-gradient(135deg, var(--bsi-teal), var(--bsi-teal-light))";
    toast.classList.add("show");
    setTimeout(() => toast.classList.remove("show"), 3000);
  }

  function login() {
    let role = document.getElementById("roleSelect").value, u = document.getElementById("username").value, p = document.getElementById("password").value;
    if ((role === 'admin' && u === USER_ADMIN.user && p === USER_ADMIN.pass) || (role === 'user' && u === USER_VIEWER.user && p === USER_VIEWER.pass)) {
      currentRole = role;
      document.getElementById("loginPage").style.display = "none";
      document.getElementById("dashboard").style.display = "flex";
      updateSidebarMenu();
      loadData();
    } else {
      document.getElementById("error").innerText = "Username atau password salah";
    }
  }
  function logout() { location.reload(); }
  function updateSidebarMenu() {
    document.querySelectorAll('.menu-for-user').forEach(m => m.style.display = currentRole === 'admin' ? 'none' : 'flex');
    showMenu('dashboard');
  }

  function loadData() {
    fetch(API_URL).then(r => r.json()).then(data => {
      headerColumns = data[0]; dataGlobal = data.slice(1);
      headerColumns.forEach((h, idx) => {
        let l = h.toLowerCase();
        if (l.includes('id')) colMap.id = idx;
        else if (l.includes('nama') || l.includes('email')) colMap.namaEmail = idx;
        else if (l.includes('usia') || l.includes('umur')) colMap.usia = idx;
        else if (l.includes('income') || l.includes('pendapatan')) colMap.income = idx;
        else if (l.includes('loan') || l.includes('pinjaman') || l.includes('plafon') || l.includes('pengajuan')) colMap.loan = idx;
        else if (l.includes('dsr') || l.includes('debt')) colMap.dsr = idx;
        else if (l.includes('grade') || l.includes('skor')) colMap.grade = idx;
      });
      for (let k in colMap) if (colMap[k] === -1) colMap[k] = ['id','namaEmail','usia','income','loan','dsr','grade'].indexOf(k);
      for (let i=0; i<headerColumns.length; i++) {
        let h = headerColumns[i].toLowerCase();
        if (h.includes('keputusan')) keputusanColIndex = i;
        if (h.trim() === 'status') statusColIndex = i;
      }
      if (keputusanColIndex === -1 && dataGlobal.length) {
        for (let i=0; i<headerColumns.length; i++) {
          let v = String(dataGlobal[0][i]).toLowerCase();
          if (v.includes('disetujui') || v.includes('ditolak')) { keputusanColIndex = i; break; }
        }
      }
      if (statusColIndex === -1 && dataGlobal.length) {
        for (let i=0; i<headerColumns.length; i++) {
          let v = String(dataGlobal[0][i]).toLowerCase();
          if (v.includes('terkirim') || v.includes('belum')) { statusColIndex = i; break; }
        }
      }
      keputusanColIndex = keputusanColIndex === -1 ? headerColumns.length-2 : keputusanColIndex;
      statusColIndex = statusColIndex === -1 ? headerColumns.length-1 : statusColIndex;
      filteredData = [...dataGlobal];
      showMenu('dashboard');
      showToast("Data berhasil dimuat", false);
    }).catch(err => { console.error(err); showToast("Gagal memuat data", true); });
  }

  function showMenu(menu) {
    if (currentRole === 'admin' && !['dashboard','debitur'].includes(menu)) menu = 'dashboard';
    document.querySelectorAll("#sidebarMenu a").forEach(a => a.classList.remove("active"));
    let active = document.querySelector(`#sidebarMenu a[data-menu="${menu}"]`);
    if (active) active.classList.add("active");
    const main = document.getElementById("mainContent");
    main.style.animation = "none";
    setTimeout(() => main.style.animation = "contentGlow 0.6s ease-out", 10);
    if (menu === 'dashboard') renderDashboard(main);
    else if (menu === 'debitur') renderDebitur(main);
    else if (menu === 'audit') renderAudit(main);
    else if (menu === 'export') renderExport(main);
    else if (menu === 'pengaturan') renderPengaturan(main);
    else if (menu === 'bantuan') renderBantuan(main);
  }

  function renderDashboard(container) {
    let disetujui=0, ditolak=0;
    dataGlobal.forEach(r => {
      let k = (r[keputusanColIndex]||'').toLowerCase();
      if (k.includes('disetujui')) disetujui++;
      else if (k.includes('ditolak')) ditolak++;
    });
    let recent = dataGlobal.slice(-5).reverse();
    let totalPlafon = 0;
    dataGlobal.forEach(r => { let p = parseFloat(r[colMap.loan]); if (!isNaN(p)) totalPlafon += p; });
    const avgPlafon = dataGlobal.length ? totalPlafon / dataGlobal.length : 0;
    const persetujuan = dataGlobal.length ? ((disetujui / dataGlobal.length) * 100).toFixed(1) : 0;

    container.innerHTML = `
      <div class="page-header"><h2><i class="fas fa-tachometer-alt"></i> Dashboard</h2><div class="header-actions"><span class="date-badge"><i class="far fa-calendar-alt"></i> ${new Date().toLocaleDateString('id-ID',{weekday:'long',day:'numeric',month:'long',year:'numeric'})}</span></div></div>
      <div class="stats-grid">
        <div class="stat-item"><div class="stat-icon"><i class="fas fa-users"></i></div><div class="stat-content"><h3>${dataGlobal.length}</h3><p>Total Debitur</p></div></div>
        <div class="stat-item"><div class="stat-icon"><i class="fas fa-check-circle"></i></div><div class="stat-content"><h3>${disetujui}</h3><p>Disetujui</p></div></div>
        <div class="stat-item"><div class="stat-icon"><i class="fas fa-times-circle"></i></div><div class="stat-content"><h3>${ditolak}</h3><p>Ditolak</p></div></div>
      </div>
      <div class="dashboard-row">
        <div class="chart-card"><h3><i class="fas fa-chart-pie"></i> Komposisi Keputusan</h3><canvas id="dashboardChart" style="max-height:280px; width:100%"></canvas></div>
        <div class="right-sidebar">
          <div class="recent-card"><h3><i class="fas fa-history"></i> Pengajuan Terbaru</h3><div class="recent-list">${recent.map(r=>{let e=r[colMap.namaEmail]||'-',k=r[keputusanColIndex]||'-',s=r[statusColIndex]||'-',d=k!=='-'?k:s,bg=k.includes('setuju')?'status-disetujui':(k.includes('tolak')?'status-ditolak':'status-terkirim'); return `<div class="recent-item"><span class="recent-email">${e}</span><span class="status-badge ${bg}">${d}</span></div>`}).join('')}</div></div>
          <div class="summary-card">
            <h3><i class="fas fa-chart-line"></i> Ringkasan Portofolio</h3>
            <div class="summary-grid">
              <div class="summary-item"><div class="label">Total Plafon</div><div class="value">Rp ${totalPlafon.toLocaleString('id-ID')}</div></div>
              <div class="summary-item"><div class="label">Rata-rata Plafon</div><div class="value">Rp ${avgPlafon.toLocaleString('id-ID')}</div></div>
              <div class="summary-item"><div class="label">Tingkat Persetujuan</div><div class="value">${persetujuan}%</div></div>
              <div class="summary-item"><div class="label">Total Log Aktivitas</div><div class="value">${auditLogs.length}</div></div>
            </div>
          </div>
        </div>
      </div>
    `;
    setTimeout(() => new Chart(document.getElementById('dashboardChart'), { type: 'doughnut', data: { labels: ['Disetujui','Ditolak'], datasets: [{ data: [disetujui,ditolak], backgroundColor: ['#00A39D','#F8AD3C'], borderColor:'white', borderWidth:8, hoverOffset: 18 }] }, options: { cutout:'75%', plugins: { legend: { position:'bottom', labels: { font: { size:14, weight:'bold' }, color: '#0F2F5F' } }, tooltip: { backgroundColor: '#0F2F5F', titleColor: '#F8AD3C', bodyColor: 'white' } } } }), 100);
  }

  function renderDebitur(container) {
    container.innerHTML = `
      <div class="page-header"><h2><i class="fas fa-users"></i> Debitur</h2><div class="header-actions"><div class="search-box"><i class="fas fa-search"></i><input type="text" id="search" placeholder="Cari debitur..."><button id="searchBtn">Cari</button><button id="clearBtn" style="background:#F1F4F9; margin-left:4px;" onclick="document.getElementById('search').value=''; filterTable()">Clear</button></div>${currentRole==='user'?'<button class="btn-add" onclick="openAddModal()"><i class="fas fa-plus"></i> Tambah</button>':''}</div></div>
      <div class="card"><div class="table-wrapper"><table id="debtorTable"><thead id="tableHeader"></thead><tbody id="tableBody"></tbody></table></div><div class="pagination" id="pagination"></div></div>
      <div class="detail-panel"><h3><i class="fas fa-id-card"></i> Detail Debitur</h3><div id="detailContent"><p style="color:#7F8C8D; text-align:center;">Klik baris untuk melihat detail lengkap</p></div><button class="clear-btn" onclick="clearSelection()"><i class="fas fa-undo-alt"></i> Hapus pilihan</button></div>
    `;
    let thead = document.getElementById("tableHeader");
    thead.innerHTML = '<tr>' + headerColumns.map(h=>`<th>${h}</th>`).join('') + (currentRole==='user'?'<th>Aksi</th>':'') + '</tr>';
    renderTable();
    document.getElementById("search").addEventListener("input", filterTable);
    document.getElementById("searchBtn").addEventListener("click", filterTable);
  }

  function renderTable() {
    let tbody = document.getElementById("tableBody"); tbody.innerHTML = "";
    let start = (currentPage-1)*rowsPerPage, end = start+rowsPerPage, page = filteredData.slice(start,end);
    page.forEach((row,idx)=>{
      let tr = document.createElement("tr"), rowId = row[colMap.id]||`row-${start+idx}`;
      tr.setAttribute("data-id", rowId);
      if (selectedRowId === rowId) tr.classList.add("selected");
      for (let i=0; i<headerColumns.length; i++) {
        let td = document.createElement("td"), val = row[i]||'-';
        if (i===colMap.income||i===colMap.loan) { let num=parseFloat(val); if (!isNaN(num)) val='Rp '+num.toLocaleString('id-ID'); }
        td.textContent = val; tr.appendChild(td);
      }
      if (currentRole==='user') {
        let td = document.createElement("td"); td.className="action-buttons";
        td.innerHTML = `<button class="btn-icon edit" onclick="openEditModal('${rowId}')"><i class="fas fa-edit"></i></button><button class="btn-icon delete" onclick="deleteData('${rowId}')"><i class="fas fa-trash"></i></button>`;
        tr.appendChild(td);
      }
      tr.addEventListener("click", (e)=> { if (!e.target.closest('.btn-icon')) showDetail(row, rowId); });
      tbody.appendChild(tr);
    });
    let total = filteredData.length, pageCount = Math.ceil(total/rowsPerPage), pag = document.getElementById("pagination"); pag.innerHTML = "";
    for (let i=1; i<=pageCount; i++) {
      let btn = document.createElement("button"); btn.textContent = i; if (i===currentPage) btn.classList.add("active");
      btn.onclick = ()=> { currentPage=i; renderTable(); }; pag.appendChild(btn);
    }
  }

  function filterTable() {
    let kw = document.getElementById("search").value.toLowerCase().trim();
    filteredData = kw ? dataGlobal.filter(r=>r.join(" ").toLowerCase().includes(kw)) : [...dataGlobal];
    currentPage=1; renderTable(); clearSelection();
  }

  function showDetail(row, rowId) {
    selectedRowId = rowId;
    document.querySelectorAll("#debtorTable tbody tr").forEach(tr=>tr.classList.remove("selected"));
    let sel = document.querySelector(`#debtorTable tbody tr[data-id="${rowId}"]`); if (sel) sel.classList.add("selected");
    let html = '<div class="detail-grid">';
    headerColumns.forEach((h,i)=>{
      let val = row[i]||'-';
      if (i===colMap.income||i===colMap.loan) { let num=parseFloat(val); if (!isNaN(num)) val='Rp '+num.toLocaleString('id-ID'); }
      html += `<div class="detail-item"><div class="label">${h}</div><div class="value">${val}</div></div>`;
    });
    html += '</div>';
    const pendapatan = parseFloat(row[colMap.income]) || 0;
    const plafonDiajukan = parseFloat(row[colMap.loan]) || 0;
    const riwayat = (row[keputusanColIndex] && row[keputusanColIndex].toLowerCase() === 'ditolak') ? 'ya' : 'tidak';
    const analysis = hitungAnalisis({ pendapatan, lamaBekerja: 0, riwayatGagalBayar: riwayat, plafonDiajukan });
    const angsuranList = hitungAngsuranPerTenor(analysis.plafonDiajukan);
    let installmentHtml = '<table class="installment-table"><thead><tr><th>Tenor (tahun)</th><th>Estimasi Angsuran / Bulan</th></tr></thead><tbody>';
    for (const a of angsuranList) installmentHtml += `<tr><td>${a.tahun} tahun</td><td>Rp ${a.angsuran.toLocaleString('id-ID')}</td></tr>`;
    installmentHtml += '</tbody></table><div class="installment-note">*Perhitungan berdasarkan plafon yang diajukan dan tabel angsuran Mitraguna.</div>';
    html += `
      <div class="analysis-card" style="margin-top: 24px;">
        <div class="analysis-title"><i class="fas fa-chart-line"></i> Analisis Kredit</div>
        <div class="analysis-grid">
          <div class="analysis-item"><div class="label">Keputusan</div><div class="value"><span class="analysis-badge ${analysis.keputusan === 'DITERIMA' ? 'badge-diterima' : 'badge-ditolak'}">${analysis.keputusan}</span></div></div>
          <div class="analysis-item"><div class="label">Risiko</div><div class="value"><span class="analysis-badge ${analysis.risiko === 'rendah' ? 'badge-rendah' : (analysis.risiko === 'sedang' ? 'badge-sedang' : 'badge-tinggi')}">${analysis.risiko.toUpperCase()}</span></div></div>
          <div class="analysis-item"><div class="label">Kemampuan Cicilan Maksimal</div><div class="value">Rp ${analysis.kemampuanCicilan.toLocaleString('id-ID')}</div></div>
          <div class="analysis-item"><div class="label">Plafon Diajukan</div><div class="value">Rp ${analysis.plafonDiajukan.toLocaleString('id-ID')}</div></div>
          <div class="analysis-item"><div class="label">Tenor Disarankan</div><div class="value">${analysis.tenorDisarankan} tahun</div></div>
          <div class="analysis-item"><div class="label">Estimasi Angsuran</div><div class="value">Rp ${analysis.estimasiAngsuranPerBulan.toLocaleString('id-ID')}</div></div>
        </div>
        ${installmentHtml}
        <div class="analysis-item" style="grid-column: span 2; margin-top: 12px;"><div class="label">Alasan</div><div class="value" style="font-size: 14px; font-weight: normal;">${analysis.alasan}</div></div>
      </div>
    `;
    document.getElementById("detailContent").innerHTML = html;
  }

  function clearSelection() { selectedRowId=null; document.querySelectorAll("#debtorTable tbody tr").forEach(tr=>tr.classList.remove("selected")); document.getElementById("detailContent").innerHTML = '<p style="color:#7F8C8D; text-align:center;">Klik baris untuk melihat detail lengkap</p>'; }

  function openAddModal() { if (currentRole!=='user') return; editingIndex=-1; document.getElementById("modalTitle").innerText="Tambah Debitur"; buildFormFields(null); document.getElementById("crudModal").classList.add("active"); updateAnalysis(); }
  function openEditModal(rowId) { if (currentRole!=='user') return; let idx = dataGlobal.findIndex(r=>r[colMap.id]==rowId); if (idx===-1) return; editingIndex=idx; document.getElementById("modalTitle").innerText="Edit Debitur"; buildFormFields(dataGlobal[idx]); document.getElementById("crudModal").classList.add("active"); updateAnalysis(); }
  function buildFormFields(rowData) {
    let fields = document.getElementById("formFields"); fields.innerHTML = "";
    for (let i=0; i<headerColumns.length; i++) {
      if (i===keputusanColIndex || i===statusColIndex) continue;
      let val = rowData ? (rowData[i]||'') : '';
      fields.innerHTML += `<div class="full-width"><label>${headerColumns[i]}</label><input type="text" id="field_${i}" value="${val.replace(/"/g,'&quot;')}" oninput="updateAnalysis()"></div>`;
    }
    let checked = rowData && (rowData[keputusanColIndex]||'').toLowerCase()==='ditolak';
    fields.innerHTML += `<div class="full-width"><label style="display:flex; align-items:center; gap:12px; margin-top:12px;"><input type="checkbox" id="riwayatGagalBayar" ${checked?'checked':''} onchange="updateAnalysis()"> <span>Riwayat Gagal Bayar</span></label></div>`;
    let statusVal = rowData ? (rowData[statusColIndex]||'') : '';
    fields.innerHTML += `<div class="full-width"><label>${headerColumns[statusColIndex]||'Status'}</label><select id="field_status"><option value="Terkirim" ${statusVal==='Terkirim'?'selected':''}>Terkirim</option><option value="Belum Terkirim" ${statusVal==='Belum Terkirim'?'selected':''}>Belum Terkirim</option></select></div>`;
  }
  function closeModal() { document.getElementById("crudModal").classList.remove("active"); }
  function saveData() {
    if (currentRole!=='user') return;
    let newRow = [];
    for (let i=0; i<headerColumns.length; i++) {
      if (i===keputusanColIndex) newRow[i]='';
      else if (i===statusColIndex) { let inp = document.getElementById("field_status"); newRow[i] = inp ? inp.value : ''; }
      else { let inp = document.getElementById(`field_${i}`); newRow[i] = inp ? inp.value : ''; }
    }
    let riwayat = document.getElementById("riwayatGagalBayar");
    newRow[keputusanColIndex] = riwayat.checked ? "Ditolak" : "Disetujui";
    if (editingIndex===-1) dataGlobal.push(newRow); else dataGlobal[editingIndex] = newRow;
    auditLogs.push({ time: new Date().toLocaleString(), user: currentRole, action: editingIndex===-1?'Tambah':'Edit', detail: 'ID: '+(newRow[colMap.id]||'-') });
    filterTable(); closeModal(); clearSelection();
    showToast(`Data ${editingIndex===-1?'ditambahkan':'diperbarui'}`, false);
  }
  async function deleteData(rowId) {
    if (currentRole!=='user') return;
    if (!confirm("Hapus data ini secara permanen?")) return;
    let idx = dataGlobal.findIndex(r=>r[colMap.id]==rowId);
    if (idx!==-1) { let deletedId = dataGlobal[idx][colMap.id]; dataGlobal.splice(idx,1); auditLogs.push({ time: new Date().toLocaleString(), user: currentRole, action:'Hapus', detail:'ID: '+deletedId }); filterTable(); clearSelection(); showToast("Data dihapus", false); }
  }

  function exportToCSV() {
    if (!filteredData.length) { showToast("Tidak ada data untuk diekspor", true); return; }
    const headers = [...headerColumns];
    const rows = filteredData.map(row => row.map(cell => `"${String(cell).replace(/"/g, '""')}"`).join(','));
    const csvContent = [headers.join(','), ...rows].join('\n');
    const blob = new Blob(["\uFEFF" + csvContent], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    const url = URL.createObjectURL(blob);
    link.href = url;
    link.setAttribute('download', 'mitraguna_data.csv');
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
    showToast("Ekspor CSV berhasil", false);
  }
  function exportToExcel() {
    if (!filteredData.length) { showToast("Tidak ada data untuk diekspor", true); return; }
    let html = '<html><head><meta charset="UTF-8"><title>Mitraguna Data</title></head><body>';
    html += '<table border="1"><tr>' + headerColumns.map(h => `<th>${h}</th>`).join('') + '</tr>';
    filteredData.forEach(row => {
      html += '<tr>' + row.map(cell => `<td>${cell}</td>`).join('') + '</tr>';
    });
    html += '</table></body></html>';
    const blob = new Blob([html], { type: 'application/vnd.ms-excel' });
    const link = document.createElement('a');
    const url = URL.createObjectURL(blob);
    link.href = url;
    link.download = 'mitraguna_data.xls';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
    showToast("Ekspor Excel berhasil", false);
  }

  function renderExport(c) {
    c.innerHTML = `
      <div class="page-header"><h2><i class="fas fa-download"></i> Export Data</h2></div>
      <div class="card">
        <h3>Ekspor Data Debitur</h3>
        <p style="margin-bottom:28px;">Unduh data dalam format pilihan Anda:</p>
        <div style="display:flex; gap:24px; flex-wrap:wrap;">
          <button class="btn-add" onclick="exportToCSV()" style="background:linear-gradient(135deg, var(--bsi-teal), var(--bsi-teal-light));"><i class="fas fa-file-csv"></i> CSV</button>
          <button class="btn-add" onclick="exportToExcel()" style="background:linear-gradient(135deg, var(--bsi-orange), var(--bsi-orange-light));"><i class="fas fa-file-excel"></i> Excel (.xls)</button>
        </div>
      </div>
    `;
  }

  function renderAudit(c) { let logs = auditLogs.length?auditLogs.map(l=>`<div style="padding:14px; border-bottom:1px solid #E9EEF2; transition:0.2s;"><span style="color:#6C7A89;">${l.time}</span> <strong style="color:var(--bsi-teal);">${l.user}</strong> – ${l.action}: ${l.detail}</div>`).join(''):'<p style="padding:20px; text-align:center;">Belum ada log aktivitas.</p>'; c.innerHTML = `<div class="page-header"><h2><i class="fas fa-history"></i> Audit Logs</h2></div><div class="card">${logs}</div><div class="card"><h3>Ringkasan</h3><p>Total log: ${auditLogs.length}</p><button class="clear-btn" onclick="if(confirm('Hapus semua log?')){ auditLogs=[]; showMenu('audit'); }"><i class="fas fa-trash"></i> Hapus Semua</button></div>`; }
  function renderPengaturan(c) { c.innerHTML = `<div class="page-header"><h2><i class="fas fa-cog"></i> Pengaturan Model</h2></div><div class="card"><h3>Parameter Model Analisis Kredit</h3><p style="margin-bottom:24px;">Atur bobot penilaian (simulasi dinamis).</p><div style="margin:24px 0;"><label>Bobot DSR: <input type="range" min="0" max="1" step="0.1" value="0.5" onchange="updateParam('dsr',this.value)"> <span id="dsrVal">0.5</span></label></div><div style="margin:24px 0;"><label>Bobot Riwayat: <input type="range" min="0" max="1" step="0.1" value="0.7" onchange="updateParam('riwayat',this.value)"> <span id="riwayatVal">0.7</span></label></div><button class="btn-add" onclick="alert('Pengaturan disimpan (simulasi).')"><i class="fas fa-save"></i> Simpan</button></div>`; }
  window.updateParam = function(p,v) { document.getElementById(p+'Val').innerText=v; };
  function renderBantuan(c) { c.innerHTML = `<div class="page-header"><h2><i class="fas fa-question-circle"></i> Bantuan</h2></div><div class="card"><h3>Cara Penggunaan Aplikasi</h3><ul style="margin-left:24px; line-height:1.9;"><li><strong>Dashboard:</strong> Statistik total, disetujui, ditolak, plus ringkasan portofolio di sebelah kanan.</li><li><strong>Debitur:</strong> Kelola data debitur (tambah, edit, hapus) – khusus user. Detail debitur muncul di bawah tabel setelah mengklik baris.</li><li><strong>Audit Logs:</strong> Catatan aktivitas user.</li><li><strong>Export:</strong> Ekspor data ke CSV atau Excel (berfungsi penuh).</li><li><strong>Pengaturan Model:</strong> Atur bobot parameter (simulasi).</li></ul><p style="margin-top:24px; background:#F8FAFE; padding:16px; border-radius:24px;"><i class="fas fa-chart-line"></i> Analisis kredit otomatis menampilkan tenor, angsuran, dan rekomendasi keputusan.</p></div>`; }

  document.querySelectorAll("#sidebarMenu a").forEach(l=>l.addEventListener("click",(e)=>{ e.preventDefault(); let m = l.getAttribute("data-menu"); if (currentRole==='admin' && !['dashboard','debitur'].includes(m)) return; showMenu(m); }));
  window.onclick = (e)=> { if (e.target===document.getElementById("crudModal")) closeModal(); };
</script>
</body>
</html>
