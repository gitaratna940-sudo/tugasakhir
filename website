    .pagination button:active::after { width: 100%; height: 100%; }
    .pagination button.active { background: linear-gradient(135deg, var(--bsi-teal), var(--bsi-teal-light)); border-color: var(--bsi-teal); color: white; box-shadow: 0 8px 18px rgba(0,163,157,0.5); transform: scale(1.08); }
